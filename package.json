{
  "name": "tts-autocomplete",
  "version": "0.1.1",
  "private": true,
  "description": "Autocomplete for the !tts command in Twitch chat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjfwebb/tts-autocomplete.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:userscript": "node scripts/build-userscript.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "icons": "node scripts/build-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fallow": "fallow",
    "fallow:check": "fallow dead-code --fail-on-issues && fallow dupes --fail-on-issues"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "fallow": "3.33.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
